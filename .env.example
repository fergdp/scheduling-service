# App Config
APP_ENVIRONMENT=development
# Observability
LOKI_URL=http://your-loki-instance:3100
APP_VERSION=1.0.0

# CORS — comma-separated list of allowed origins (no spaces).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://atuconsul.com,https://www.atuconsul.com

# Security (MUST MATCH Main Backend)
JWT_SECRET_KEY=your_base64_encoded_jwt_secret_here

# Database (dental_scheduling_db)
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dental_scheduling_db

# DB principal (dental-clinic) — solo para resolver user_id -> clinic_id en el cross-check #82 H1.
# La tabla `users` vive en dental_clinic_db_v3, no en la DB de scheduling.
CLINIC_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dental_clinic_db_v3

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://atuconsul.com/clinic-scheduling-api/v1/oauth/callback

# Token Encryption (32-byte Fernet Key)
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here
